# Browser business API prefix; authentication uses Bearer tokens from login.
VITE_API_BASE_URL=/api/v1
# Browser health prefix: Vite rewrites /backend/health to backend /health.
VITE_BACKEND_BASE_URL=/backend
# Development-only proxy target; never put credentials in this URL or VITE_*.
BACKEND_PROXY_TARGET=http://127.0.0.1:8080
# Direct Spring uses /health; the deployed HTTPS gateway uses /backend/health.
BACKEND_HEALTH_PATH=/health
